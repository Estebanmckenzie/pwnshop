<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Become a Seller - Pwnshop</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="stylesheet" href="/css/style.css?v=2">
    <style>
        body { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; background: var(--gray-100); }
        .seller-card { background: var(--white); border-radius: 20px; box-shadow: 0 8px 40px rgba(59,7,100,0.13); width: 100%; max-width: 920px; display: grid; grid-template-columns: 1fr 1fr; overflow: hidden; min-height: 560px; }

        /* ── LEFT PANEL ── */
        .panel-left {
            background: linear-gradient(145deg, var(--purple-deep), var(--purple-mid));
            padding: 48px 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .panel-left::before {
            content: '';
            position: absolute;
            width: 260px;
            height: 260px;
            background: rgba(168,85,247,0.15);
            border-radius: 50%;
            top: -60px;
            right: -80px;
        }

        .panel-left::after {
            content: '';
            position: absolute;
            width: 180px;
            height: 180px;
            background: rgba(192,38,211,0.12);
            border-radius: 50%;
            bottom: -40px;
            left: -40px;
        }

        .brand-logo {
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            font-size: 1.7rem;
            color: var(--white);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            position: relative;
            z-index: 1;
        }

        .brand-logo .dot {
            width: 8px;
            height: 8px;
            background: var(--purple-light);
            border-radius: 50%;
        }

        .panel-headline {
            position: relative;
            z-index: 1;
        }

        .panel-headline h2 {
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            font-size: 1.9rem;
            color: var(--white);
            line-height: 1.25;
            margin-bottom: 14px;
        }

        .panel-headline p {
            color: rgba(255,255,255,0.72);
            font-size: 0.9rem;
            line-height: 1.6;
        }

        /* Seller benefits */
        .seller-benefits {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .benefit-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .benefit-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: rgba(255,255,255,0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .benefit-icon i {
            font-size: 0.95rem;
            color: var(--purple-light);
        }

        .benefit-text strong {
            display: block;
            color: var(--white);
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 1px;
        }

        .benefit-text span {
            color: rgba(255,255,255,0.6);
            font-size: 0.78rem;
        }

        /* ── RIGHT PANEL ── */
        .panel-right {
            padding: 48px 44px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .badge-seller {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--purple-pale);
            color: var(--purple-mid);
            font-size: 0.75rem;
            font-weight: 700;
            border-radius: 20px;
            padding: 4px 12px;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            margin-bottom: 16px;
        }

        .panel-right h3 {
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--black);
            margin-bottom: 8px;
            line-height: 1.3;
        }

        .panel-right .subtitle {
            color: var(--gray-500);
            font-size: 0.875rem;
            margin-bottom: 32px;
            line-height: 1.55;
        }

        /* Request status notice */
        .seller-notice {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 14px 16px;
            margin-bottom: 24px;
            border-radius: 10px;
            background: var(--purple-pale);
            border: 1.5px solid var(--purple-light);
            color: var(--purple-deep);
            font-size: 0.875rem;
            line-height: 1.5;
        }

        /* Confirm steps */
        .confirm-steps {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 32px;
        }

        .step-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            background: var(--gray-100);
            border-radius: 10px;
            border: 1.5px solid var(--gray-200);
        }

        .step-num {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--purple-deep);
            color: var(--white);
            font-size: 0.75rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .step-item span {
            font-size: 0.85rem;
            color: var(--black);
            font-weight: 500;
        }

        /* ── BUTTONS ── */
        .btn-confirm {
            background: var(--purple-deep);
            color: var(--white);
            border: none;
            border-radius: 10px;
            padding: 13px;
            font-size: 0.92rem;
            font-weight: 700;
            font-family: 'DM Sans', sans-serif;
            width: 100%;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-confirm:hover {
            background: var(--purple-mid);
            transform: translateY(-1px);
        }

        .btn-back {
            display: block;
            text-align: center;
            margin-top: 16px;
            color: var(--gray-500);
            font-size: 0.83rem;
            text-decoration: none;
            transition: color 0.2s;
        }

        .btn-back:hover { color: var(--purple-mid); }

        @media (max-width: 640px) {
            .seller-card { grid-template-columns: 1fr; }
            .panel-left { display: none; }
            .panel-right { padding: 36px 28px; }
        }
    </style>
    <link rel="stylesheet" href="/css/mobile-responsive.css">
</head>
<body>

<div class="seller-card">


    <div class="panel-left">
        <a href="/" class="brand-logo">Pwnshop<span class="dot"></span></a>

        <div class="panel-headline">
            <h2>Start selling today.</h2>
            <p>Join our growing community of sellers and reach thousands of buyers across the platform.</p>
        </div>

        <div class="seller-benefits">
            <div class="benefit-item">
                <div class="benefit-icon"><i class="bi bi-graph-up-arrow"></i></div>
                <div class="benefit-text">
                    <strong>Grow your revenue</strong>
                    <span>Access a large, active buyer base</span>
                </div>
            </div>
            <div class="benefit-item">
                <div class="benefit-icon"><i class="bi bi-layout-text-sidebar"></i></div>
                <div class="benefit-text">
                    <strong>Manage with ease</strong>
                    <span>Simple dashboard for all your listings</span>
                </div>
            </div>
            <div class="benefit-item">
                <div class="benefit-icon"><i class="bi bi-shield-lock"></i></div>
                <div class="benefit-text">
                    <strong>Secure payments</strong>
                    <span>Reliable payouts directly to your account</span>
                </div>
            </div>
            <div class="benefit-item">
                <div class="benefit-icon"><i class="bi bi-headset"></i></div>
                <div class="benefit-text">
                    <strong>Dedicated support</strong>
                    <span>Our team is here to help you succeed</span>
                </div>
            </div>
        </div>
    </div>


    <div class="panel-right">
        <div class="badge-seller"><i class="bi bi-shop"></i> Seller Programme</div>
        <h3>Request a seller account</h3>
        <p class="subtitle">
            Seller accounts are reviewed by our team before activation. Here's how it works:
        </p>

        <% const sellerNotice = typeof notice !== 'undefined' ? notice : null; %>
        <% if (sellerNotice === 'sent') { %>
            <div class="seller-notice"><i class="bi bi-send-check"></i>
                <span>Your request has been sent. An administrator will review it and you will be notified once your seller account is active.</span></div>
        <% } else if (sellerNotice === 'pending') { %>
            <div class="seller-notice"><i class="bi bi-hourglass-split"></i>
                <span>You already have a pending seller request. An administrator will review it soon.</span></div>
        <% } else if (sellerNotice === 'already') { %>
            <div class="seller-notice"><i class="bi bi-patch-check"></i>
                <span>Your account already has seller access.</span></div>
        <% } %>

        <div class="confirm-steps">
            <div class="step-item">
                <div class="step-num">1</div>
                <span>You send a request to become a <strong>Seller</strong></span>
            </div>
            <div class="step-item">
                <div class="step-num">2</div>
                <span>An <strong>administrator</strong> reviews and approves it</span>
            </div>
            <div class="step-item">
                <div class="step-num">3</div>
                <span>Once approved, you get <strong>Add Product</strong> and your storefront appears in <strong>Featured Sellers</strong></span>
            </div>
        </div>

        <% if (!sellerNotice) { %>
        <form method="POST" action="/register-seller">
            <button type="submit" class="btn-confirm">
                <i class="bi bi-send-fill"></i>
                Request Seller Account
            </button>
        </form>
        <% } %>

        <a href="/" class="btn-back">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
    </div>

</div>

    <%- include('chat-widget') %>
<script src="/js/mobile-nav.js"></script>
</body>
</html>
